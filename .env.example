# BC125AT Web Controller — environment config
# Copy to .env and edit as needed. Never commit .env to git.

# Serial port (Windows: COM3 / Linux: /dev/ttyACM0)
SCANNER_PORT=COM3
SCANNER_BAUD=115200
SCANNER_POLL_INTERVAL=0.5

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False
SECRET_KEY=change-me-in-production

# Recordings output directory
RECORDINGS_DIR=recordings
